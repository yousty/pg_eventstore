<% type = event_type.is_a?(Hash) ? event_type[:type] : event_type %>
<% markers = event_type.is_a?(Hash) ? event_type[:markers] : [] %>
<div class="form-row align-items-center">
  <div class="col-5">
    <select name="filter[events][][type]" class="form-control mb-2 type-filter" data-placeholder="Event type" data-url="<%= url('/event_types_filtering') %>" autocomplete="off">
      <option></option>
      <% if type %>
        <% if type == PgEventstore::Web::Application::EMPTY_STRING_SIGN %>
          <option class="zero-byte-val" selected></option>
        <% else %>
          <option value="<%= h type %>" selected><%= h type %></option>
        <% end %>
      <% end %>
    </select>
  </div>
  <div class="col-5">
    <select name="filter[events][][markers][]" class="form-control mb-2 event-markers-filter" data-placeholder="Event markers" data-url="<%= url('/markers_filtering') %>" autocomplete="off" multiple>
      <% markers.each do |marker| %>
        <% if marker == PgEventstore::Web::Application::EMPTY_STRING_SIGN %>
          <option class="zero-byte-val" selected></option>
        <% else %>
          <option value="<%= h marker %>" selected><%= h marker %></option>
        <% end %>
      <% end %>
    </select>
  </div>
  <div class="col-1">
    <a class="btn btn-default remove-filter" href="javascript: void(0);">
      <i class="fa fa-minus-circle"></i>
    </a>
  </div>
</div>
