module PgEventstore
  module QueryBuilders
    module Filters
      class EventTypeFilter
        include Extensions::OptionsExtension
        include Extensions::OptionsDefaults

        attr_accessor event_type: String?
        attr_accessor prefix: bool

        def self.null_filter: -> EventTypeFilter

        def prefix?: -> bool

        def to_sql_value: -> String?
      end
    end
  end
end
