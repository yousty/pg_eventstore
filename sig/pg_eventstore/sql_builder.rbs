module PgEventstore
  class SQLBuilder
    UNION_MODES: Array[Symbol]

    @from_value: (String | SQLBuilder)?
    @group_values: Array[String]
    @join_values: Array[untyped]
    @limit_value: Integer?
    @offset_value: Integer?
    @order_values: Array[String]
    @select_values: Array[String]
    @union_mode: Symbol
    @union_values: Array[SQLBuilder]
    @where_values: Hash[String, Array[untyped]]

    def self.union_builders: (Array[SQLBuilder] builders, ?mode: Symbol) -> SQLBuilder

    def self.wrap_union_builder: (SQLBuilder builder) -> SQLBuilder

    attr_reader positional_values: Array[untyped]
    attr_reader table_alias: String?

    attr_writer positional_values_size: Integer

    def initialize: () -> void

    def from_sql: -> String

    # _@param_ `sql`
    def select: (String sql) -> self

    def union_builder?: -> bool

    def union_mode=: (Symbol val) -> void

    def unselect: () -> self

    # _@param_ `sql`
    #
    # _@param_ `arguments` — positional values
    def where: (String sql, *untyped arguments) -> self

    # _@param_ `sql`
    #
    # _@param_ `arguments` — positional values
    def where_or: (String sql, *Object arguments) -> self

    # _@param_ `table_name`
    def from: (String | SQLBuilder table_name) -> self

    # _@param_ `sql`
    #
    # _@param_ `arguments`
    def join: (String sql, *Object arguments) -> self

    # _@param_ `sql`
    def order: (String sql) -> self

    def remove_order: () -> self

    # _@param_ `limit`
    def limit: (Integer limit) -> self

    def remove_limit: () -> self

    # _@param_ `offset`
    def offset: (Integer offset) -> self

    # _@param_ `another_builder`
    def union: (SQLBuilder another_builder) -> self

    # _@param_ `sql`
    def group: (String sql) -> self

    def remove_group: () -> self

    def to_exec_params: () -> [String, ::Array[untyped]]

    def _to_exec_params: () -> [String, ::Array[untyped]]

    def single_query_sql: () -> String

    def union_query_sql: () -> String

    def select_sql: () -> String

    # _@param_ `join_pattern` — "OR"/"AND"
    def where_sql: (String join_pattern) -> String

    def join_sql: () -> String

    def order_sql: () -> String

    # _@param_ `sql`
    def extract_positional_args: (String sql, *untyped arguments) -> String

    private

    def merge: (SQLBuilder builder) -> String
  end
end
