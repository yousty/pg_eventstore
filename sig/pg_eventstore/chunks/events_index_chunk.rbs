module PgEventstore
  module Chunks
    class EventsIndexChunk
      include Chunk

      MAX_PARTITIONS_TO_RESOLVE_PER_CALL: Integer

      @connection: Connection
      @raw_events: Array[Hash[String, untyped]]
      @idx_direction: Symbol
      @indexes: Array[EventGlobalIndex]
      @last_global_position: Integer?
      @query_strategy: QueryStrategy
      @resolve_link_tos: bool
      @resolved: bool

      attr_reader last_global_position: Integer?

      def initialize: (Array[EventGlobalIndex] indexes, Connection connection, QueryStrategy query_strategy,
          bool resolve_link_tos) -> void

      private

      def detect_direction: (EventGlobalIndex? idx1, EventGlobalIndex? idx2) -> Symbol

      def events_global_index_queries: -> EventsGlobalIndexQueries

      def range_to_slice: -> Range[Integer]

      def resolve_indexes: -> void

      def resolved?: -> bool
    end
  end
end
